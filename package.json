{
  "name": "taxcom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate && playwright install"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "^5.19.1",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "@playwright/test": "^1.51.1",
    "postcss": "^8.4.35",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
